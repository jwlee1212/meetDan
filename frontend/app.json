{
  "expo": {
    "name": "mitdan",
    "slug": "mitdan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mitdan",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dlwodnek.mitdan"
    },
    "android": {
      "package": "com.dlwodnek.mitdan",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "ios": {
            "image": "./assets/images/splash-tagline.png",
            "imageWidth": 168,
            "resizeMode": "contain",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-calendar",
        {
          "calendarPermission": "확정된 미팅 약속을 캘린더에 저장하기 위해 접근 권한이 필요해요."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3288FF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f69d946-250c-40cb-a296-fcda74442f98"
      }
    },
    "owner": "dlwodnek"
  }
}
